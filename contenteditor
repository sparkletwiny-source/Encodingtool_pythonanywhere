</select>
</div>

<div class="field">
<label for="to">To</label>
<input id="to" value="{to}">
</div>

<div class="field">
<label for="date">Date</label>
<input id="date" value="{hdt}">
</div>

<div class="field">
<label for="emailInput">Complete EML Content</label>
<textarea
id="emailInput"
placeholder="Paste complete EML or Base64 content here..."
spellcheck="false"
></textarea>
</div>

<div class="buttons">
<button onclick="processEmail()">Process Email</button>
<button class="secondary" onclick="clearAll()">Clear All</button>
</div>

<p class="note">
Base64 HTML/Text is decoded automatically before header replacement.
List-ID header is removed from output.
</p>

</section>


<section class="panel">

<h2>Processed Output</h2>

<div class="field">
<label for="output">Output EML</label>
<textarea
id="output"
readonly
placeholder="Processed output will appear here..."
spellcheck="false"
></textarea>
</div>

<div class="buttons">
<button onclick="copyOutput()">Copy Output</button>
<button onclick="downloadEML()">Download EML</button>
<button onclick="downloadTXT()">Download TXT</button>
</div>

<div id="status" class="status"></div>

</section>

</div>
</div>


<script>

// ======================================
// BASIC HELPERS
// ======================================

function normalizeLineEndings(text) {
    return text.replace(/\r\n/g, "\n").replace(/\r/g, "\n");
}

function setStatus(message, success = true) {
    const status = document.getElementById("status");
    status.style.color = success ? "#267346" : "#d64545";
    status.textContent = message;
}


// ======================================
// PASTE HANDLER
// ======================================

document.getElementById("emailInput")
.addEventListener("paste", function(event) {

    event.preventDefault();

    const pastedText = event.clipboardData
        ? event.clipboardData.getData("text")
        : "";

    const cleaned = pastedText
        .replace(/<\/style\s*>/gi, "")
        .replace(/\s+$/, "");

    const finalText =
        cleaned + (cleaned ? "\n" : "") + "</style>";

    const start = this.selectionStart;
    const end = this.selectionEnd;

    this.value =
        this.value.substring(0, start) +
        finalText +
        this.value.substring(end);

    const cursor = start + finalText.length;
    this.setSelectionRange(cursor, cursor);
});


// ======================================
// STYLE TAG HELPERS
// ======================================

function removeStyleClosings(text) {
    return text.replace(/<\/style\s*>/gi, "").trim();
}

function addFinalStyleClosing(text) {
    return removeStyleClosings(text) + "\n</style>";
}


// ======================================
// BASE64 DECODER
// ======================================

function decodeBase64Content(content) {

    try {

        let clean = content
            .replace(/<\/style\s*>/gi, "")
            .replace(/[\r\n\t ]/g, "")
            .replace(/-/g, "+")
            .replace(/_/g, "/");

        clean = clean.replace(/=+$/, "");

        if (!clean || clean.length % 4 === 1) {
            return null;
        }

        const remainder = clean.length % 4;

        if (remainder > 0) {
            clean += "=".repeat(4 - remainder);
        }

        if (!/^[A-Za-z0-9+/]*={0,2}$/.test(clean)) {
            return null;
        }

        const binary = atob(clean);

        const bytes = Uint8Array.from(
            binary,
            char => char.charCodeAt(0)
        );

        try {
            return new TextDecoder("utf-8", {
                fatal: true
            }).decode(bytes);
        } catch (error) {
            return new TextDecoder("windows-1252").decode(bytes);
        }

    } catch (error) {
        return null;
    }
}


// ======================================
// RAW BASE64 DETECTION
// ======================================

function isRawBase64(text) {

    let clean = text
        .replace(/<\/style\s*>/gi, "")
        .replace(/\s/g, "");

    if (clean.length < 40) {
        return false;
    }

    clean = clean.replace(/=+$/, "");

    if (clean.length % 4 === 1) {
        return false;
    }

    return /^[A-Za-z0-9+/_-]+$/.test(clean);
}

function decodeRawBase64(text) {

    const cleaned = removeStyleClosings(text);

    if (!isRawBase64(cleaned)) {
        return null;
    }

    return decodeBase64Content(cleaned);
}


// ======================================
// MIME HELPERS
// ======================================

function splitMimeEntity(raw) {

    const separator = /\n[ \t]*\n/.exec(raw);

    if (!separator) {
        return null;
    }

    const index = separator.index;

    return {
        headers: raw.slice(0, index),
        body: raw.slice(index + separator[0].length)
    };
}

function unfoldHeaders(headers) {
    return headers.replace(/\n[ \t]+/g, " ");
}

function getBoundary(headers) {

    const match = headers.match(
        /boundary\s*=\s*(?:"([^"]+)"|'([^']+)'|([^;\s]+))/i
    );

    return match
        ? (match[1] || match[2] || match[3])
        : null;
}


// ======================================
// MIME BASE64 PROCESSING
// ======================================

function processMimeEntity(raw, depth = 0) {

    if (depth > 12) {
        return raw;
    }

    const entity = splitMimeEntity(raw);

    if (!entity) {
        return raw;
    }

    let headers = entity.headers;
    let body = entity.body;

    const unfolded = unfoldHeaders(headers);

    const contentTypeMatch = unfolded.match(
        /^Content-Type\s*:\s*([^;\n]+)/im
    );

    const contentType = contentTypeMatch
        ? contentTypeMatch[1].trim().toLowerCase()
        : "";

    const boundary = getBoundary(unfolded);


    // MULTIPART PROCESSING

    if (boundary) {

        const lines = body.split("\n");
        const output = [];

        let currentPart = [];
        let insidePart = false;

        const boundaryStart = "--" + boundary;
        const boundaryEnd = boundaryStart + "--";

        function flushPart() {

            if (!currentPart.length) {
                return;
            }

            const part = currentPart.join("\n");

            if (part.trim()) {
                output.push(
                    processMimeEntity(part, depth + 1)
                );
            }

            currentPart = [];
        }

        for (const line of lines) {

            const trimmed = line.trim();

            if (
                trimmed === boundaryStart ||
                trimmed === boundaryEnd
            ) {

                flushPart();

                insidePart = trimmed !== boundaryEnd;

                continue;
            }

            if (insidePart) {
                currentPart.push(line);
            }
        }

        flushPart();

        const remainingHeaders = headers
            .split("\n")
            .filter(line =>
                !/^Content-Type\s*:/i.test(line) &&
                !/^Content-Transfer-Encoding\s*:/i.test(line)
            )
            .join("\n");

        return (
            remainingHeaders +
            (remainingHeaders ? "\n\n" : "") +
            output.join("\n\n")
        );
    }


    // ATTACHMENT DETECTION

    const isAttachment =
        /Content-Disposition\s*:\s*attachment/i.test(unfolded) ||
        /filename\s*=/i.test(unfolded);


    // TEXT CONTENT DETECTION

    const isTextContent =
        contentType.startsWith("text/") ||
        contentType.includes("html") ||
        contentType.includes("xml") ||
        contentType.includes("json");


    // BASE64 HEADER DETECTION

    const isBase64Header =
        /^Content-Transfer-Encoding\s*:\s*base64\s*$/im.test(headers);


    // DECODE TEXT/HTML BASE64

    if (
        isBase64Header &&
        isTextContent &&
        !isAttachment
    ) {

        const decoded = decodeBase64Content(body);

        if (decoded !== null) {

            body = decoded;

            headers = headers.replace(
                /^Content-Transfer-Encoding\s*:\s*base64\s*$/im,
                "Content-Transfer-Encoding: 7bit"
            );
        }
    }

    return headers + "\n\n" + body;
}


// ======================================
// REMOVE LIST-ID HEADER
// ======================================

function removeListIdHeader(headers) {

    const lines = headers.split("\n");
    const result = [];

    let skipContinuation = false;

    for (const line of lines) {

        if (/^[ \t]/.test(line) && skipContinuation) {
            continue;
        }

        skipContinuation = false;

        if (/^List-ID\s*:/i.test(line)) {
            skipContinuation = true;
            continue;
        }

        result.push(line);
    }

    return result.join("\n");
}


// ======================================
// HEADER REPLACEMENT
// ======================================

function updateExistingHeader(headers, headerName, newValue) {

    const lines = headers.split("\n");
    const result = [];

    let updated = false;
    let skipContinuation = false;

    for (const line of lines) {

        if (/^[ \t]/.test(line) && skipContinuation) {
            continue;
        }

        skipContinuation = false;

        const colonIndex = line.indexOf(":");

        if (colonIndex > 0) {

            const currentName = line
                .slice(0, colonIndex)
                .trim();

            if (
                currentName.toLowerCase() ===
                headerName.toLowerCase()
            ) {

                result.push(
                    currentName + ": " + newValue
                );

                updated = true;
                skipContinuation = true;

                continue;
            }
        }

        result.push(line);
    }

    if (!updated) {
        result.push(headerName + ": " + newValue);
    }

    return {
        headers: result.join("\n"),
        updated: updated
    };
}


// ======================================
// SPLIT EMAIL
// ======================================

function splitEmail(raw) {

    const separator = /\n[ \t]*\n/.exec(raw);

    if (!separator) {
        return null;
    }

    const index = separator.index;

    return {
        headers: raw.slice(0, index),
        body: raw.slice(index + separator[0].length)
    };
}


// ======================================
// REMOVE MIME BOUNDARY LINES
// ======================================

function removeBoundaryLines(text) {

    return text.replace(
        /^[ \t]*--[^\r\n]+--?[ \t]*$/gm,
        ""
    );
}


// ======================================
// MAIN PROCESS
// ======================================

function processEmail() {

    const input =
        document.getElementById("emailInput").value;

    const output =
        document.getElementById("output");

    output.value = "";

    if (!input.trim()) {
        setStatus("Please paste your EML content first.", false);
        return;
    }

    let processed = normalizeLineEndings(input);

    let decodedCount = 0;


    // STEP 1: RAW BASE64 CHECK

    const rawDecoded = decodeRawBase64(processed);

    if (rawDecoded !== null) {

        processed = rawDecoded;
        decodedCount++;

    } else {

        // STEP 2: MIME BASE64 PROCESSING

        processed = processMimeEntity(processed);
    }


    // STEP 3: REMOVE BOUNDARY LINES

    processed = removeBoundaryLines(processed);


    // STEP 4: SPLIT EMAIL

    const parts = splitEmail(processed);


    // RAW HTML/TEXT OUTPUT

    if (!parts) {

        output.value = addFinalStyleClosing(processed);

        setStatus(
            "Processing complete. " +
            (decodedCount
                ? "Raw Base64 decoded successfully."
                : "No valid raw Base64 detected.")
        );

        return;
    }


    // STEP 5: REMOVE LIST-ID HEADER

    let headers = removeListIdHeader(parts.headers);


    // STEP 6: BUILD FROM VALUE

    const fromValue =
        document.getElementById("from").value +
        "<" +
        document.getElementById("listid").value +
        ">";


    // STEP 7: UPDATE REQUIRED HEADERS
    // List-ID is intentionally excluded.

    const replacements = [

        {
            name: "Subject",
            value: document.getElementById("subject").value
        },

        {
            name: "From",
            value: fromValue
        },

        {
            name: "To",
            value: document.getElementById("to").value
        },

        {
            name: "Date",
            value: document.getElementById("date").value
        }

    ];

    for (const item of replacements) {

        const result = updateExistingHeader(
            headers,
            item.name,
            item.value
        );

        headers = result.headers;
    }


    // STEP 8: REMOVE LIST-ID AGAIN
    // Ensures it cannot remain in output.

    headers = removeListIdHeader(headers);


    // STEP 9: FINAL OUTPUT

    let finalOutput =
        headers +
        "\n\n" +
        parts.body;

    finalOutput = removeBoundaryLines(finalOutput);
    finalOutput = addFinalStyleClosing(finalOutput);

    output.value = finalOutput;


    setStatus(
        "Processing complete. " +
        "Base64 processing finished. " +
        "Updated headers: Subject, From, To, Date. " +
        "List-ID header removed."
    );
}


// ======================================
// COPY OUTPUT
// ======================================

async function copyOutput() {

    const output =
        document.getElementById("output");

    if (!output.value) {
        setStatus("There is no output to copy.", false);
        return;
    }

    try {

        await navigator.clipboard.writeText(output.value);

        setStatus("Output copied successfully.");

    } catch (error) {

        output.focus();
        output.select();

        const success = document.execCommand("copy");

        setStatus(
            success
                ? "Output copied successfully."
                : "Copy failed. Please copy manually.",
            success
        );
    }
}


// ======================================
// DOWNLOAD FILE
// ======================================

function downloadFile(filename, content, mimeType) {

    if (!content) {
        setStatus("There is no output to download.", false);
        return;
    }

    const blob = new Blob(
        [content],
        { type: mimeType }
    );

    const url = URL.createObjectURL(blob);

    const link = document.createElement("a");

    link.href = url;
    link.download = filename;

    document.body.appendChild(link);

    link.click();

    link.remove();

    setTimeout(() => {
        URL.revokeObjectURL(url);
    }, 1000);
}


function downloadEML() {

    downloadFile(
        "processed_email.eml",
        document.getElementById("output").value,
        "message/rfc822"
    );
}


function downloadTXT() {

    downloadFile(
        "processed_email.txt",
        document.getElementById("output").value,
        "text/plain;charset=utf-8"
    );
}


// ======================================
// CLEAR ALL
// ======================================

function clearAll() {

    document.getElementById("emailInput").value = "";
    document.getElementById("output").value = "";
    document.getElementById("status").textContent = "";

    document.getElementById("subject").value = "{sub}";
    document.getElementById("from").value = "{from}";
    document.getElementById("listid").value = "{listid}";
    document.getElementById("to").value = "{to}";
    document.getElementById("date").value = "{hdt}";
}
</script>

</body>
