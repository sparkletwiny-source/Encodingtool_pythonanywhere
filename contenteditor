
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Email Header Replacer</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 20px;
    font-family: Arial, sans-serif;
    background: #f1f3f8;
    color: #222;
}

.container {
    max-width: 1450px;
    margin: auto;
}

h1 {
    text-align: center;
    color: #263b60;
    margin-bottom: 22px;
}

.main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.panel {
    min-width: 0;
    background: #fff;
    padding: 20px;
    border-radius: 11px;
    box-shadow: 0 2px 12px #00000012;
    min-height: 650px;
}

h2 {
    margin: 0 0 18px;
    color: #263b60;
    font-size: 20px;
}

.field {
    margin-bottom: 15px;
}

label {
    display: block;
    margin-bottom: 6px;
    font-size: 14px;
    font-weight: bold;
}

input,
select,
textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #cbd2df;
    border-radius: 5px;
    font-family: Consolas, monospace;
    font-size: 13px;
    background: #fff;
}

input:focus,
select:focus,
textarea:focus {
    outline: none;
    border-color: #356ae6;
}

textarea {
    resize: vertical;
    min-height: 320px;
    line-height: 1.5;
    overflow-wrap: anywhere;
}

#output {
    min-height: 500px;
    background: #fafbfe;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}

.buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 15px;
}

button {
    border: none;
    border-radius: 5px;
    padding: 12px 16px;
    background: #356ae6;
    color: white;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    opacity: .88;
}

.secondary {
    background: #526176;
}

.status {
    margin-top: 13px;
    font-size: 13px;
    line-height: 1.5;
    overflow-wrap: anywhere;
}

.note {
    font-size: 12px;
    color: #526176;
    line-height: 1.5;
    margin-top: 12px;
}

@media(max-width: 850px) {
    .main {
        grid-template-columns: 1fr;
    }

    body {
        padding: 10px;
    }

    .panel {
        padding: 15px;
    }
}
</style>
</head>

<body>

<div class="container">

<h1>Email Header Replacer</h1>

<div class="main">

<section class="panel">

<h2>Input</h2>

